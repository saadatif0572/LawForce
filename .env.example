# ==============================================================================
# LAWVERSE Environment Configuration
# ==============================================================================
# IMPORTANT: Never commit real API keys or secrets to Git or share them publicly.
# Copy this file to .env and fill in the required values.

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# API backend URL for client-side queries
VITE_API_URL=http://localhost:8000

# Supabase Managed Authentication (Frontend Publishable credentials only)
# Obtain these from your Supabase project dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=LAWVERSE
DEBUG=true
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Auth Verification (Backend JWKS for JWT signature validation)
# Obtain from https://<your-project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Optional Supabase JWT Secret for symmetric HMAC signature validation
SUPABASE_JWT_SECRET=replace_with_jwt_secret_if_applicable

# PostgreSQL Database (Supabase PostgreSQL or local integration instance)
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# For local SQLite development fallback: sqlite:///./lawverse.db
DATABASE_URL=postgresql://postgres:replace_password@db.your-project.supabase.co:5432/postgres

# Qdrant Vector Database
# Local instance default: http://localhost:6333 (leave QDRANT_API_KEY empty for local)
# Cloud instance: https://[your-cluster-id].qdrant.tech:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=replace_with_qdrant_key
QDRANT_COLLECTION=lawverse_legal_documents

# Groq API Key (Strictly backend only)
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=replace_with_new_groq_key
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding Model (BAAI/bge-m3 default multilingual embedding model)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Ingestion & Raw Data Path
DATA_RAW_DIR=./data/raw
CORPUS_MANIFEST_PATH=./corpus/manifest.csv
